{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs"
    },
    "citizen": {
      "root": "apps/citizen",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/citizen/(.*)",
      "destination": {
        "service": "citizen"
      }
    },
    {
      "source": "/citizen",
      "destination": {
        "service": "citizen"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "admin"
      }
    }
  ]
}
