rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isZoneManager() {
      return hasRole('zone_manager') || isSuperAdmin();
    }

    function isEnforcementOfficer() {
      return hasRole('enforcement_officer') || isSuperAdmin();
    }

    function isFinanceAuditor() {
      return hasRole('finance_auditor') || isSuperAdmin();
    }

    // 1. Zones: Public read for citizens, managed by Zone Managers / Super Admins
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isZoneManager();
    }

    // 2. Bays: Public read for slot availability, managed by Zone Managers / Super Admins
    match /bays/{bayId} {
      allow read: if true;
      allow write: if isZoneManager();
    }

    // 3. Sensors: Internal telemetry, viewable by staff, writeable by Super Admin / Server
    match /sensors/{sensorId} {
      allow read: if isEnforcementOfficer() || isZoneManager();
      allow write: if isSuperAdmin();
    }

    // 4. Events: Append-only ledger, viewable by operational roles, writeable by Super Admin / Server
    match /events/{eventId} {
      allow read: if isEnforcementOfficer() || isZoneManager();
      allow write: if isSuperAdmin();
    }

    // 5. Reservations: Citizens manage their own; staff can view
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isZoneManager() ||
        isEnforcementOfficer()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        isZoneManager()
      );
      allow delete: if isSuperAdmin();
    }

    // 6. Payments: STRICT security — A citizen must NEVER read another citizen's payments!
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isFinanceAuditor()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isFinanceAuditor();
      allow delete: if false; // Financial records are immutable
    }

    // 7. Pricing Rules: Public read, Super Admin write
    match /pricing_rules/{ruleId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 8. Price History: Public read for transparency, written by system / Super Admin
    match /price_history/{historyId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 9. Violations: Managed by Enforcement Officers and Super Admins
    match /violations/{violationId} {
      allow read: if isEnforcementOfficer() || isZoneManager() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow create, update: if isEnforcementOfficer();
      allow delete: if isSuperAdmin();
    }

    // 10. Users: Users manage their own profile, Super Admin has full view
    match /users/{userId} {
      allow read: if isUser(userId) || isSuperAdmin();
      allow create, update: if isUser(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // 11. Audit Logs: Read-only for Super Admin and Finance Auditor, direct client writes blocked
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || isFinanceAuditor();
      allow write: if isSuperAdmin();
    }

    // 12. Forecasts: Public read for analytics & citizen booking lookahead, Super Admin / Functions write
    match /forecasts/{zoneId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
