# ==========================================
# PARKSENSE ENVIRONMENT CONFIGURATION
# Copy to .env.local for local development
# NEVER COMMIT SECRETS OR .env.local TO GIT
# ==========================================

# Node Environment
NODE_ENV=development

# Firebase Project Info
NEXT_PUBLIC_FIREBASE_PROJECT_ID=parksense-india
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=parksense-india.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=parksense-india
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=parksense-india.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeEmulatorKeyForLocalDevOnly

# Firebase Emulator Hosts (Local Development)
USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# Cloud Functions Ingestion Webhook URL
INGESTION_ENDPOINT_URL=http://127.0.0.1:5001/parksense-india/us-central1/ingestEvent
GATEWAY_SECRET_KEY=parksense_gateway_hmac_secret_delhi_2026

# Simulator Configuration
SIMULATOR_SPEED=10x
SIMULATOR_SCENARIO=normal-weekday
SIMULATOR_SEED=parksense-2026-delhi
SIMULATOR_CITY_CONFIG=configs/delhi-ncr.json

# Razorpay Test Mode (Used in Phase 2)
RAZORPAY_KEY_ID=rzp_test_ParkSenseDemoKey
RAZORPAY_KEY_SECRET=rzp_test_ParkSenseDemoSecret

# Gemini API (Server-Side Only, Used in Phase 3)
GEMINI_API_KEY=your_gemini_api_key_here

# MapLibre / OpenStreetMap Tiles
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
