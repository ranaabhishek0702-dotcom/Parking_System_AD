{
  "name": "parksense-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "seed": "tsx src/seeder.ts",
    "backfill": "tsx src/backfill.ts",
    "simulate": "tsx src/index.ts",
    "simulate:ipl": "tsx src/index.ts --scenario ipl-match-night --speed 60x",
    "simulate:diwali": "tsx src/index.ts --scenario diwali-shopping-rush --speed 60x"
  },
  "dependencies": {
    "@parksense/shared": "*",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "firebase-admin": "^12.7.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
